<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>items</key>
	<array>
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>Other Music Apps</string>
            <key>footerText</key><string>Configure external lyrics fallback for Spotify, YouTube, and other music apps.</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>External App Lyrics</string>
            <key>key</key><string>ExternalAppsEnabled</string>
            <key>default</key><true/>
            <key>defaults</key><string>com.shalamand3r.datelyrics</string>
            <key>PostNotification</key><string>com.shalamand3r.datelyrics/ReloadPrefs</string>
        </dict>
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>Always-On Display</string>
            <key>footerText</key><string>Request one extra refresh 10% into each lyric line’s visibility. Retries stop before the next line and when the display wakes or AOD lyrics are off. Requires Always-On Display support.</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>Retry AOD Line Refresh</string>
            <key>key</key><string>AODRefreshRetry</string>
            <key>default</key><true/>
            <key>defaults</key><string>com.shalamand3r.datelyrics</string>
            <key>PostNotification</key><string>com.shalamand3r.datelyrics/ReloadPrefs</string>
        </dict>


		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Storage &amp; Cache</string>
			<key>footerText</key>
			<string>Delete all locally saved lyrics and score files to force fresh lookups on next playback.</string>
		</dict>
		<dict>
            <key>cell</key>
			<string>PSButtonCell</string>
			<key>id</key>
			<string>WipeSavedLyrics</string>
			<key>label</key>
			<string>Wipe Lyrics Cache</string>
			<key>action</key>
			<string>wipeSavedLyrics</string>
			<key>isDestructive</key>
			<true/>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Reset Settings</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>Reset Settings</string>
			<key>action</key>
			<string>resetSettings</string>
			<key>isDestructive</key>
			<true/>
			<key>confirmation</key>
			<dict>
				<key>prompt</key>
				<string>Reset all DateLyrics settings and remove your custom Musixmatch token? Saved lyrics will be kept.</string>
				<key>title</key>
				<string>Reset All</string>
				<key>okTitle</key>
				<string>Reset</string>
				<key>cancelTitle</key>
				<string>Cancel</string>
			</dict>
		</dict>
		<dict>
			<key>DateLyricsInternalDiagnostics</key><true/>
            <key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Diagnostics</string>
			<key>footerText</key>
			<string>Temporarily write diagnostic events to /var/mobile/Library/DateLyrics/tweak-debug.log. Disable after testing.</string>
		</dict>
		<dict>
			<key>DateLyricsInternalDiagnostics</key><true/>
            <key>cell</key>
			<string>PSSwitchCell</string>
			<key>key</key>
			<string>DebugLogging</string>
			<key>label</key>
			<string>Debug Logging</string>
			<key>iconImageSystem</key>
			<dict>
				<key>name</key>
				<string>doc.text.magnifyingglass</string>
			</dict>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.shalamand3r.datelyrics</string>
			<key>PostNotification</key>
			<string>com.shalamand3r.datelyrics/ReloadPrefs</string>
		</dict>
		<dict>
			<key>DateLyricsInternalDiagnostics</key><true/>
            <key>cell</key>
			<string>PSSwitchCell</string>
			<key>key</key>
			<string>NativeTransitionProbe</string>
			<key>label</key>
			<string>Native Transition Probe</string>
			<key>iconImageSystem</key>
			<dict>
				<key>name</key>
				<string>cpu</string>
			</dict>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.shalamand3r.datelyrics</string>
			<key>PostNotification</key>
			<string>com.shalamand3r.datelyrics/ReloadPrefs</string>
		</dict>
		<dict>
			<key>DateLyricsInternalDiagnostics</key><true/>
            <key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>View Debug Log</string>
			<key>action</key>
			<string>showDebugLog</string>
		</dict>
		<dict>
			<key>DateLyricsInternalDiagnostics</key><true/>
            <key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>Copy Debug Log</string>
			<key>action</key>
			<string>copyDebugLog</string>
		</dict>
		<dict>
			<key>DateLyricsInternalDiagnostics</key><true/>
            <key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>Clear Debug Log</string>
			<key>action</key>
			<string>clearDebugLog</string>
			<key>isDestructive</key>
			<true/>
			<key>confirmation</key>
			<dict>
				<key>title</key>
				<string>Clear Debug Log?</string>
				<key>prompt</key>
				<string>This permanently removes the current DateLyrics diagnostic log.</string>
			</dict>
		</dict>
	</array>
	<key>title</key>
	<string>Experimental</string>
</dict>
</plist>
